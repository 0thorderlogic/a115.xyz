---
import Layout from "../layout/Layout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import type { Props as Publication } from "../components/PublicationCard.astro";
import publicationsData from "../content/publications.json";

const publications = publicationsData as Publication[];
---

<Layout title="Homepage">
  <section class="w-full space-y-8">
    <div class="space-y-3">
      <main class="title-2 text-slate-200">
        <div class="my-2.5">
          I'm a Researcher at
          <a href="https://neuroailabs.in/" target="_blank" class="text-rose-500!">
            NeuroAI Labs
          </a>
          <sup><a href="#3" class="no-underline!">[3]</a></sup>
        </div>

        <div class="my-2.5">
          <span class="text-teal-400">sanket (at) a115 (dot) xyz</span>
        </div>
        <div class="my-2.5">
          <span class="text-orange-400">aryan115csphy (at) gmail (dot) com</span>
        </div>
        <div class="my-2.5">
          <span class="text-purple-400">aryan (at) neuroailabs (dot) in</span>
        </div>

        <div class="my-2.5">
          more <sup><a href="#1" class="no-underline!">[1]</a></sup>
        </div>
      </main>
    </div>

    <div class="my-10 space-y-4">
      <h2 class="title-2">Publications</h2>
      {
        publications.length > 0 ? (
          publications.map((pub) => <PublicationCard {...pub} />)
        ) : (
          <p class="text-slate-400">Nothing here yet.</p>
        )
      }
    </div>

    <div class="my-10">
      <h2 class="title-2">In the past</h2>
      <ul>
        <li>
          I used to work at the <a
            href="https://www.isical.ac.in"
            target="_blank"
            class="text-[#C1272D]!">Indian Statistical Institute, Calcutta</a
          ><sup><a href="#2" class="no-underline!">[2]</a></sup>
        </li>
        <li>I taught Mathematics to many students from the USA, Canada, and the UK</li>
        <li>
          I spent many years earning a degree in Computer Science and Engineering from <a
            href="https://www.makautwb.ac.in/"
            target="_blank"
            class="text-[#b1ddf6]!">Maulana Abul Kalam Azad University of Technology, West Bengal</a
          >
        </li>
      </ul>
    </div>
    <div class="my-10">
      <h2 class="title-2">Links</h2>
      <ol>
        <li>
          <a href="/r">Redirect</a> or "GOTO" page, my one-stop link shortner/redirect page
        </li>
        <p>
          Do note that even though I have accounts at these places I really dislike social media,
          and as such don't update it. Any relevant information will be present on this website or
          can be requested via email listed on the top of this page.
        </p>
        <li>
          Elsewhere:
          <a href="https://github.com/0thorderlogic" target="_blank" class="text-red-400!">github</a
          >,
          <a href="https://bsky.app/profile/a115.xyz" target="_blank" class="text-sky-500!">bsky</a
          >,
          <a href="https://x.com/0thorderlogic" target="_blank" class="text-mauve-500!">x</a>
        </li>
        <li>
          <a href="/pdfs/2023/Map.pdf" target="_blank" class="text-purple-500!">Kolkata Metro map</a
          >
        </li>
        <li>
          <a href="https://fmhy.net/" target="_blank" class="text-emerald-500!"
            >Free media heck yeah</a
          >
        </li>
        <li>
          <a
            href="https://www.amazon.in/hz/wishlist/ls/24YJ3FROBSSHY"
            target="_blank"
            class="text-amber-500!">Amazon Books Wishlist</a
          >
        </li>
      </ol>
    </div>
    <div class="my-10">
      <h2 class="title-2">Footnotes</h2>
      <div class="text-xl">
        <sub id="3">[3] As of April 1<sup>st</sup>, 2026 </sub><br />
        <sub id="2">[2] As of March 31<sup>st</sup>, 2026 </sub><br />
        <sub id="1">[1] I don't do much </sub>
      </div>
    </div>
  </section>
</Layout>
